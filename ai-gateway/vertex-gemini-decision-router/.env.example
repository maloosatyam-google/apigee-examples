# Target Apigee X Organization & Environment
APIGEE_ORG="your-apigee-org"
APIGEE_ENV="dev"
# Northbound HTTPS hostname configured on your Apigee Environment Group
APIGEE_HOST="api.example.com"

# GCP Project & Region for Vertex AI, Gemini Decisions API, and optional Model Armor
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# Optional: Existing runtime Service Account email (created automatically if blank)
PROXY_SA_EMAIL=""

# Optional: Enable Model Armor prompt & SSE response sanitization ("on" or "off")
# Set CREATE_ARMOR_TEMPLATES="true" to also create default Model Armor templates in GCP_REGION
MODEL_ARMOR="off"
CREATE_ARMOR_TEMPLATES="false"
