<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="true" enabled="true" name="AM-SetResponseHeaders">
  <DisplayName>AM-SetResponseHeaders</DisplayName>
  <Set>
    <Headers>
      <Header name="x-gateway-model">{flow.target_model}</Header>
      <Header name="x-auto-routed">{flow.autoRouted}</Header>
      <Header name="x-gateway-routing-tier">{flow.routingTier}</Header>
      <Header name="x-gateway-router-engine">{flow.routerEngine}</Header>
      <Header name="x-gateway-router-category">{flow.routerCategory}</Header>
      <Header name="x-gateway-router-confidence">{flow.routerConfidence}</Header>
      <Header name="x-gateway-router-complexity">{flow.routerComplexity}</Header>
      <Header name="x-gateway-router-input-tokens">{flow.routerInputTokens}</Header>
      <Header name="x-gateway-router-output-tokens">{flow.routerOutputTokens}</Header>
      <Header name="x-gateway-guardrails">armor-prompt={flow.guardrail.armorPrompt};armor-response={flow.guardrail.armorResponse}</Header>
      <Header name="x-gateway-prompt-tokens">{flow.promptTokenCount}</Header>
      <Header name="x-gateway-candidates-tokens">{flow.candidatesTokenCount}</Header>
      <Header name="x-gateway-thoughts-tokens">{flow.thoughtsTokenCount}</Header>
      <Header name="x-gateway-total-tokens">{flow.totalTokenCount}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
