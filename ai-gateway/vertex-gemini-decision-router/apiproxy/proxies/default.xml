<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>EV-ExtractAPIKey</Name>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
      </Step>
      <Step>
        <Name>SA-SpikeArrest</Name>
      </Step>
      <Step>
        <Name>AM-ResolveGuardrailToggles</Name>
      </Step>
      <Step>
        <Name>EV-RequestDetails</Name>
      </Step>
      <Step>
        <Name>JS-ExtractPromptAndModel</Name>
      </Step>
      <Step>
        <Name>SUP-UserPrompt</Name>
        <Condition>(flow.userPrompt != null) and (flow.userPrompt != "") and (flow.guardrail.armorPrompt != "off")</Condition>
      </Step>
      <Step>
        <Name>AM-RemoveAuthorization</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="AutoRoutingFlow">
      <Description>Intelligent auto-routing via Google Gemini Decision 1 (gemini-decision-1) and API Product custom attributes</Description>
      <Request>
        <Step>
          <Name>LTQ-TokenEnforce</Name>
        </Step>
        <Step>
          <Name>AM-PrepRouterRequest</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "")</Condition>
        </Step>
        <Step>
          <Name>SC-ModelRouter</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "")</Condition>
        </Step>
        <Step>
          <Name>JS-AutoRouting</Name>
        </Step>
        <Step>
          <Name>RF-MissingRoutingConfig</Name>
          <Condition>(flow.target_model == null) or (flow.target_model == "")</Condition>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.verb == "POST") and (flow.is_auto_route == "true")</Condition>
    </Flow>
    <Flow name="GeminiGenerateContent">
      <Description>Direct Vertex AI Gemini generateContent and streamGenerateContent</Description>
      <Request>
        <Step>
          <Name>LTQ-TokenEnforce</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.verb == "POST") and (flow.is_valid_gemini_path == "true")</Condition>
    </Flow>
    <Flow name="UnsupportedPath">
      <Description>Reject unsupported paths or HTTP methods with 404</Description>
      <Request>
        <Step>
          <Name>RF-UnsupportedPath</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ModelResponse</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true") and (flow.guardrail.armorResponse != "off")</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>AM-SetResponseHeaders</Name>
      </Step>
    </Response>
  </PostFlow>
  <PostClientFlow>
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <DefaultFaultRule name="attribute-fault-analytics">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>DC-FaultAnalytics</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPProxyConnection>
    <BasePath>/vertex-router/v1</BasePath>
    <Properties>
      <Property name="io.timeout.millis">300000</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="gemini-stream-target">
    <Condition>flow.is_streaming == "true"</Condition>
    <TargetEndpoint>gemini-vertex-stream-target</TargetEndpoint>
  </RouteRule>
  <RouteRule name="gemini-target">
    <TargetEndpoint>gemini-vertex-target</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
