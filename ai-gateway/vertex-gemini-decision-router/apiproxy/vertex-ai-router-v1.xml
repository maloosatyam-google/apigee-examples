<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="vertex-ai-router-v1">
  <DisplayName>Vertex AI Gemini Gateway with Gemini Decision 1 Auto-Routing</DisplayName>
  <Description>Apigee AI Gateway built on vertex-ai-v1 with zero-output-token auto-routing via Gemini Decision 1 (POST /v1beta/decisions), persona-based API Product model maps, API Key verification, Spike Arrest, LLM Token Quota, toggleable Model Armor (buffered + SSE ContinuousScan), Data Capture, and Cloud Logging.</Description>
  <BasePaths>/vertex-router/v1</BasePaths>
  <Policies>
    <Policy>AM-PrepRouterRequest</Policy>
    <Policy>AM-RemoveAuthorization</Policy>
    <Policy>AM-ResolveGuardrailToggles</Policy>
    <Policy>AM-RouteGeminiTarget</Policy>
    <Policy>AM-SetResponseHeaders</Policy>
    <Policy>DC-FaultAnalytics</Policy>
    <Policy>DC-ModelAnalytics</Policy>
    <Policy>EV-ExtractAPIKey</Policy>
    <Policy>EV-ModelResponse</Policy>
    <Policy>EV-RequestDetails</Policy>
    <Policy>JS-AutoRouting</Policy>
    <Policy>JS-ExtractPromptAndModel</Policy>
    <Policy>JS-ProcessStreamEvent</Policy>
    <Policy>LTQ-TokenCount</Policy>
    <Policy>LTQ-TokenCountSSE</Policy>
    <Policy>LTQ-TokenEnforce</Policy>
    <Policy>ML-CloudLogging</Policy>
    <Policy>RF-MissingRoutingConfig</Policy>
    <Policy>RF-UnsupportedPath</Policy>
    <Policy>SA-SpikeArrest</Policy>
    <Policy>SC-ModelRouter</Policy>
    <Policy>SMR-SanitizeModelResponse</Policy>
    <Policy>SMR-SanitizeModelResponseSSE</Policy>
    <Policy>SUP-UserPrompt</Policy>
    <Policy>VA-VerifyAPIKey</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>jsc://AutoRouting.js</Resource>
    <Resource>jsc://ExtractPromptAndModel.js</Resource>
    <Resource>jsc://ProcessStreamEvent.js</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>gemini-vertex-stream-target</TargetEndpoint>
    <TargetEndpoint>gemini-vertex-target</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
