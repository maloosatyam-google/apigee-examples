<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>EV-ExtractAPIKey</Name>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
      </Step>
      <Step>
        <Name>SA-SpikeArrest</Name>
      </Step>
      <Step>
        <Name>EV-RequestDetails</Name>
      </Step>
      <Step>
        <Name>JS-ExtractPromptAndModel</Name>
      </Step>
      <Step>
        <Name>AM-RemoveAuthorization</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="AutoRoutingFlow">
      <Description>Native 2-step cascaded auto-routing: Step 1 via Gemini Decision 1 (&gt;= 0.70 confidence), Step 2 fallback via Gemini 3.5 Flash-Lite (&lt; 0.70 confidence)</Description>
      <Request>
        <Step>
          <Name>LTQ-TokenEnforce</Name>
        </Step>
        <Step>
          <Name>AM-InitAutoRouting</Name>
        </Step>
        <!-- Step 1: Zero-output-token prefill classification via Gemini Decision 1 -->
        <Step>
          <Name>AM-PrepStep1Decision</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "")</Condition>
        </Step>
        <Step>
          <Name>SC-Step1DecisionRouter</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "")</Condition>
        </Step>
        <Step>
          <Name>EV-ParseStep1Decision</Name>
          <Condition>routerStep1Response.status.code = 200</Condition>
        </Step>
        <Step>
          <Name>AM-AcceptStep1Decision</Name>
          <Condition>(flow.step1Category != null) and (flow.step1Confidence != null) and (flow.step1Confidence &gt;= 0.70) and (request.header.x-force-step2 != "true")</Condition>
        </Step>
        <!-- Step 2: Disambiguation via Gemini 3.5 Flash-Lite ONLY when Step 1 was ambiguous (< 0.70) or unavailable -->
        <Step>
          <Name>AM-PrepStep2FlashLite</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "") and (flow.step1Accepted != "true")</Condition>
        </Step>
        <Step>
          <Name>SC-Step2FlashLiteRouter</Name>
          <Condition>(flow.routerInput != null) and (flow.routerInput != "") and (flow.step1Accepted != "true")</Condition>
        </Step>
        <Step>
          <Name>EV-ParseStep2FlashLite</Name>
          <Condition>(flow.step1Accepted != "true") and (routerStep2Response.status.code = 200)</Condition>
        </Step>
        <Step>
          <Name>AM-AcceptStep2Decision</Name>
          <Condition>(flow.step1Accepted != "true") and (flow.step2RawJson != null) and (flow.step2RawJson != "")</Condition>
        </Step>
        <!-- Native API Product model resolution (general is pre-initialized in AM-InitAutoRouting) -->
        <Step>
          <Name>AM-RouteCoding</Name>
          <Condition>(flow.routerCategory := "coding") and (verifyapikey.VA-VerifyAPIKey.apiproduct.routing.model.coding != null)</Condition>
        </Step>
        <Step>
          <Name>AM-RouteDeepReasoning</Name>
          <Condition>(flow.routerCategory := "deep_reasoning") and (verifyapikey.VA-VerifyAPIKey.apiproduct.routing.model.deep_reasoning != null)</Condition>
        </Step>
        <Step>
          <Name>AM-RouteSimple</Name>
          <Condition>(flow.routerCategory := "simple") and (verifyapikey.VA-VerifyAPIKey.apiproduct.routing.model.simple != null)</Condition>
        </Step>
        <Step>
          <Name>RF-MissingRoutingConfig</Name>
          <Condition>(flow.target_model == null) or (flow.target_model == "")</Condition>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.verb == "POST") and (flow.is_auto_route == "true")</Condition>
    </Flow>
    <Flow name="GeminiGenerateContent">
      <Description>Direct Vertex AI Gemini generateContent and streamGenerateContent</Description>
      <Request>
        <Step>
          <Name>LTQ-TokenEnforce</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.verb == "POST") and (flow.is_valid_gemini_path == "true")</Condition>
    </Flow>
    <Flow name="UnsupportedPath">
      <Description>Reject unsupported paths or HTTP methods with 404</Description>
      <Request>
        <Step>
          <Name>RF-UnsupportedPath</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ModelResponse</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>(response.status.code = 200) and (flow.is_streaming != "true")</Condition>
      </Step>
      <Step>
        <Name>AM-SetResponseHeaders</Name>
      </Step>
    </Response>
  </PostFlow>
  <PostClientFlow>
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <DefaultFaultRule name="attribute-fault-analytics">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>DC-FaultAnalytics</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPProxyConnection>
    <BasePath>/vertex-two-step/v1</BasePath>
    <Properties>
      <Property name="io.timeout.millis">300000</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="gemini-stream-target">
    <Condition>flow.is_streaming == "true"</Condition>
    <TargetEndpoint>gemini-vertex-stream-target</TargetEndpoint>
  </RouteRule>
  <RouteRule name="gemini-target">
    <TargetEndpoint>gemini-vertex-target</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
